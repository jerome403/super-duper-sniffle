# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Storage paths
STORAGE_PATH=./uploads
TEMP_PATH=./temp

# Redis (for job queue integration)
REDIS_URL=redis://localhost:6379

# Anthropic API for document classification
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OCR settings
TESSERACT_CMD=  # Leave empty if tesseract is in PATH
OCR_DPI=300
OCR_CONFIDENCE_THRESHOLD=0.7

# Processing limits
MAX_FILE_SIZE_MB=500
MAX_PAGES_PER_DOCUMENT=5000
